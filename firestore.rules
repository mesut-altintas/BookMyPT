rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isPt() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pt';
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Returns true if the current user is a participant of the given chat.
    // Supports both 1:1 chats (ptId / memberId) and group chats (participants array).
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return chat != null &&
        (chat.data.ptId == request.auth.uid ||
         chat.data.memberId == request.auth.uid ||
         request.auth.uid in chat.data.get('participants', []));
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin() ||
        (isPt() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ptId']));
      allow delete: if isAdmin();
    }

    // PT Members subcollection
    match /pts/{ptId}/members/{memberId} {
      allow read: if isAuthenticated() &&
        (isOwner(ptId) || isOwner(memberId));
      allow create: if isAuthenticated() && (isOwner(ptId) || isOwner(memberId));
      allow update: if isAuthenticated() && (isOwner(ptId) || isOwner(memberId));
      allow delete: if isAuthenticated() && isOwner(ptId);
    }

    // PT Packages subcollection
    match /pts/{ptId}/packages/{packageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(ptId);
      allow update: if isAuthenticated() && isOwner(ptId);
      allow delete: if isAuthenticated() && isOwner(ptId);
    }

    // Programs collection
    match /programs/{programId} {
      allow read: if isAuthenticated() &&
        (resource == null ||
         resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated() && isPt() &&
        request.resource.data.ptId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isAdmin() || (isAuthenticated() &&
        (resource == null ||
         resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid ||
         exists(/databases/$(database)/documents/pts/$(resource.data.ptId)/members/$(request.auth.uid))));
      allow create: if isAuthenticated() &&
        (request.resource.data.ptId == request.auth.uid ||
         request.resource.data.memberId == request.auth.uid);
      allow update: if isAdmin() || (isAuthenticated() &&
        (resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid));
      allow delete: if isAdmin() || (isAuthenticated() &&
        resource.data.ptId == request.auth.uid);
    }

    // Payments collection (individual + group)
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() &&
        (resource.data.memberId == request.auth.uid ||
         resource.data.ptId == request.auth.uid));
      allow create: if isAuthenticated() &&
        request.resource.data.memberId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() &&
        resource.data.ptId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Progress collection
    match /progress/{progressId} {
      allow read: if isAuthenticated() &&
        (resource.data.memberId == request.auth.uid ||
         exists(/databases/$(database)/documents/pts/$(request.auth.uid)/members/$(resource.data.memberId)));
      allow create: if isAuthenticated() &&
        request.resource.data.memberId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.memberId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.memberId == request.auth.uid;
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() &&
        (resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid);
      allow create: if isAuthenticated() && (
        (isPt() && request.resource.data.ptId == request.auth.uid) ||
        (request.resource.data.memberId == request.auth.uid)
      );
      allow update: if isAuthenticated() &&
        (resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid);
      allow delete: if false;
    }

    // Personal events collection
    match /personal_events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.memberId == request.auth.uid ||
        exists(/databases/$(database)/documents/pts/$(resource.data.memberId)/members/$(request.auth.uid))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.memberId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.memberId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.memberId == request.auth.uid;
    }

    // Chats collection (1:1 and group)
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        (resource == null ||
         resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid ||
         request.auth.uid in resource.data.get('participants', []));
      allow create: if isAuthenticated() && (
        // Group chat: only the PT can create
        (request.resource.data.get('isGroup', false) == true &&
         request.resource.data.ptId == request.auth.uid) ||
        // 1:1 chat: a PT-member relationship must exist
        (request.resource.data.get('isGroup', false) != true &&
         (request.resource.data.ptId == request.auth.uid ||
          request.resource.data.memberId == request.auth.uid) &&
         exists(/databases/$(database)/documents/pts/$(request.resource.data.ptId)/members/$(request.resource.data.memberId)))
      );
      allow update: if isAuthenticated() &&
        (resource.data.ptId == request.auth.uid ||
         resource.data.memberId == request.auth.uid ||
         request.auth.uid in resource.data.get('participants', []));
      // 1:1 chats: either participant may delete.
      // Group chats: only the PT may delete (e.g. when deleting the group).
      allow delete: if isAuthenticated() && (
        (!resource.data.get('isGroup', false) &&
          (resource.data.ptId == request.auth.uid ||
           resource.data.memberId == request.auth.uid)) ||
        (resource.data.get('isGroup', false) &&
          resource.data.ptId == request.auth.uid)
      );

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isChatParticipant(chatId);
        allow create: if isAuthenticated() &&
          isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && isChatParticipant(chatId);
        allow delete: if false;
      }
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ptId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
    }

    // Group packages collection
    match /group_packages/{packageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ptId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
    }

    // Group sessions collection
    match /group_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ptId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ptId == request.auth.uid;
      allow delete: if false;
    }

    // Waitlist collection
    match /waitlist/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
