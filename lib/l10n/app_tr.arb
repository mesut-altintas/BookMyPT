  "helpHomeItem3Title": "Üyeliği Bırak",
  "@helpHomeItem3Title": { "description": "Help home item 3 title (member)" },

  "helpHomeItem3Body": "PT kartındaki \"Üyeliği Bırak\" butonuyla eğitmeninizle bağlantınızı kesebilirsiniz. Kalan seans haklarınız bu işlemden etkilenmez.",
  "@helpHomeItem3Body": { "description": "Help home item 3 body (member)" },

  "helpCalendarTitle": "Randevularım",
  "@helpCalendarTitle": { "description": "Help calendar section title (member)" },

  "helpCalendarItem1Title": "Randevu Talebi Oluşturma",
  "@helpCalendarItem1Title": { "description": "Help calendar item 1 title" },

  "helpCalendarItem1Body": "Sağ üstteki + butonuna basın, tarih ve saati seçin. Paketinizde seans süresi tanımlıysa otomatik belirlenir. Talebiniz PT onayına gönderilir.",
  "@helpCalendarItem1Body": { "description": "Help calendar item 1 body" },

  "helpCalendarItem2Title": "Takvim Sekmesi",
  "@helpCalendarItem2Title": { "description": "Help calendar item 2 title" },

  "helpCalendarItem2Body": "Günlük bazda tüm randevularınızı görürsünüz. Mavi nokta kendi randevularınızı, gri nokta PT'nin meşgul olduğu saatleri gösterir. Bekleyen taleplerinize tıklayarak tarih veya saati değiştirebilirsiniz.",
  "@helpCalendarItem2Body": { "description": "Help calendar item 2 body" },

  "helpCalendarItem3Title": "Geçmişim Sekmesi",
  "@helpCalendarItem3Title": { "description": "Help calendar item 3 title" },

  "helpCalendarItem3Body": "Tamamlanan seanslarınızın sayısı ve toplam süresini burada görürsünüz. Yaklaşan onaylı randevularınız da bu sekmede listelenir.",
  "@helpCalendarItem3Body": { "description": "Help calendar item 3 body" },

  "helpCalendarItem4Title": "Randevu Durumları",
  "@helpCalendarItem4Title": { "description": "Help calendar item 4 title" },

  "helpCalendarItem4Body": "• Bekliyor: Talep oluşturuldu, PT onayı bekleniyor.\n• Onaylandı: PT kabul etti, seans gerçekleşecek.\n• Tamamlandı: Seans gerçekleşti.\n• İptal: Seans iptal edildi.",
  "@helpCalendarItem4Body": { "description": "Help calendar item 4 body" },

  "helpMyCalendarTitle": "Takvimim",
  "@helpMyCalendarTitle": { "description": "Help my-calendar section title (member)" },

  "helpMyCalendarItem1Title": "Kişisel Etkinlik Ekleme",
  "@helpMyCalendarItem1Title": { "description": "Help my-calendar item 1 title" },

  "helpMyCalendarItem1Body": "Sağ üstteki + butonuyla kişisel etkinlikler ekleyebilirsiniz (antrenman, toplantı, tatil vb.). Bu etkinlikler yalnızca sizin takviminizde görünür.",
  "@helpMyCalendarItem1Body": { "description": "Help my-calendar item 1 body" },

  "helpMyCalendarItem2Title": "PT'nin Müsaitliği",
  "@helpMyCalendarItem2Title": { "description": "Help my-calendar item 2 title" },

  "helpMyCalendarItem2Body": "PT'nizin başka üyelerle olan randevuları ve kişisel etkinlikleri gri renkte görünür. Böylece randevu talebinde bulunmadan önce müsaitliği kontrol edebilirsiniz.",
  "@helpMyCalendarItem2Body": { "description": "Help my-calendar item 2 body" },

  "helpMyCalendarItem3Title": "Etkinlik Düzenleme",
  "@helpMyCalendarItem3Title": { "description": "Help my-calendar item 3 title" },

  "helpMyCalendarItem3Body": "Eklediğiniz kişisel etkinliklere tıklayarak tarih, saat, süre ve notlarını düzenleyebilir ya da silebilirsiniz.",
  "@helpMyCalendarItem3Body": { "description": "Help my-calendar item 3 body" },

  "helpPackagesTitle": "Paketlerim",
  "@helpPackagesTitle": { "description": "Help packages section title (member)" },

  "helpPackagesItem1Title": "Paket Satın Alma",
  "@helpPackagesItem1Title": { "description": "Help packages item 1 title" },

  "helpPackagesItem1Body": "PT'nizin sunduğu seans paketlerini bu ekranda görürsünüz. \"Satın Al\" butonuna bastığınızda ödeme talebi oluşur; PT onayladıktan sonra seans hakkınız hesabınıza eklenir.",
  "@helpPackagesItem1Body": { "description": "Help packages item 1 body" },

  "helpPackagesItem2Title": "Üyeye Özel Paketler",
  "@helpPackagesItem2Title": { "description": "Help packages item 2 title" },

  "helpPackagesItem2Body": "PT'niz sizin için özel fiyatlı veya süreli paket oluşturmuş olabilir. Bu paketleri yalnızca siz görebilirsiniz.",
  "@helpPackagesItem2Body": { "description": "Help packages item 2 body" },

  "helpPackagesItem3Title": "Ödeme Geçmişi",
  "@helpPackagesItem3Title": { "description": "Help packages item 3 title" },

  "helpPackagesItem3Body": "Tüm ödeme talepleriniz ve durumları (Bekliyor / Tamamlandı) ekranın üst kısmında listelenir.",
  "@helpPackagesItem3Body": { "description": "Help packages item 3 body" },

  "helpProgressTitle": "İlerleme",
  "@helpProgressTitle": { "description": "Help progress section title (member)" },

  "helpProgressItem1Title": "Ölçüm Girişi",
  "@helpProgressItem1Title": { "description": "Help progress item 1 title" },

  "helpProgressItem1Body": "Kilo, boy ve vücut ölçülerinizi kaydedebilirsiniz. Fotoğraf ekleyerek görsel ilerlemenizi de takip edebilirsiniz.",
  "@helpProgressItem1Body": { "description": "Help progress item 1 body" },

  "helpProgressItem2Title": "Geçmişe Dönük Giriş",
  "@helpProgressItem2Title": { "description": "Help progress item 2 title" },

  "helpProgressItem2Body": "Girişi unuttuğunuz günler için tarih seçerek geçmişe dönük kayıt yapabilirsiniz.",
  "@helpProgressItem2Body": { "description": "Help progress item 2 body" },

  "helpProgressItem3Title": "Grafik Takibi",
  "@helpProgressItem3Title": { "description": "Help progress item 3 title" },

  "helpProgressItem3Body": "Kaydettiğiniz ölçümler grafik olarak gösterilir. Zaman içindeki değişiminizi kolayca izleyebilirsiniz.",
  "@helpProgressItem3Body": { "description": "Help progress item 3 body" },

  "helpMessagesTitle": "Mesajlar",
  "@helpMessagesTitle": { "description": "Help messages section title" },

  "helpMemberMessagesItem1Title": "PT ile İletişim",
  "@helpMemberMessagesItem1Title": { "description": "Help messages item 1 title (member)" },

  "helpMemberMessagesItem1Body": "PT'nizle doğrudan mesajlaşabilirsiniz. Seans değişiklikleri, sorular veya antrenman notları için bu ekranı kullanın.",
  "@helpMemberMessagesItem1Body": { "description": "Help messages item 1 body (member)" },

  "helpPtHomeItem1Title": "Günlük Özet",
  "@helpPtHomeItem1Title": { "description": "Help home item 1 title (PT)" },

  "helpPtHomeItem1Body": "Bugünkü randevularınız, bekleyen talepler ve son üye hareketleri ana ekranda listelenir.",
  "@helpPtHomeItem1Body": { "description": "Help home item 1 body (PT)" },

  "helpPtHomeItem2Title": "Bekleyen Talepler",
  "@helpPtHomeItem2Title": { "description": "Help home item 2 title (PT)" },

  "helpPtHomeItem2Body": "Üyelerinizin randevu taleplerini buradan hızlıca onaylayabilir veya reddedebilirsiniz. Onay verdiğinizde üyeye bildirim gider.",
  "@helpPtHomeItem2Body": { "description": "Help home item 2 body (PT)" },

  "helpPtHomeItem3Title": "Aktivasyon İstekleri",
  "@helpPtHomeItem3Title": { "description": "Help home item 3 title (PT)" },

  "helpPtHomeItem3Body": "Pasif üyeler aktivasyon isteği gönderebilir. Bu istekleri ana ekrandan yönetebilirsiniz.",
  "@helpPtHomeItem3Body": { "description": "Help home item 3 body (PT)" },

  "helpPtCalendarTitle": "Takvim",
  "@helpPtCalendarTitle": { "description": "Help calendar section title (PT)" },

  "helpPtCalendarItem1Title": "Randevu Yönetimi",
  "@helpPtCalendarItem1Title": { "description": "Help PT calendar item 1 title" },

  "helpPtCalendarItem1Body": "Tüm üyelerinizin seansları takvimde renkli noktalarla görünür. Bir güne tıklayarak o günkü detaylı listeye geçebilirsiniz.",
  "@helpPtCalendarItem1Body": { "description": "Help PT calendar item 1 body" },

  "helpPtCalendarItem2Title": "Kişisel Etkinlik",
  "@helpPtCalendarItem2Title": { "description": "Help PT calendar item 2 title" },

  "helpPtCalendarItem2Body": "Sağ üstteki + butonu ile tatil, toplantı gibi kişisel etkinlikler ekleyebilirsiniz. Bu saatler üyelerin randevu takviminde \"meşgul\" olarak görünür.",
  "@helpPtCalendarItem2Body": { "description": "Help PT calendar item 2 body" },

  "helpPtCalendarItem3Title": "Seans Detayı",
  "@helpPtCalendarItem3Title": { "description": "Help PT calendar item 3 title" },

  "helpPtCalendarItem3Body": "Listedeki bir seansa tıklayarak detay ekranını açabilir, durumu güncelleyebilir (onayla / iptal / tamamla) ve notlar ekleyebilirsiniz.",
  "@helpPtCalendarItem3Body": { "description": "Help PT calendar item 3 body" },

  "helpPtMembersTitle": "Üyeler",
  "@helpPtMembersTitle": { "description": "Help PT members section title" },

  "helpPtMembersItem1Title": "Üye Ekleme",
  "@helpPtMembersItem1Title": { "description": "Help PT members item 1 title" },

  "helpPtMembersItem1Body": "Yeni üye eklemek için + butonuna basın ve üyenin bilgilerini girin. Sisteme eklenen üye size bağlanır ve randevu alabilir.",
  "@helpPtMembersItem1Body": { "description": "Help PT members item 1 body" },

  "helpPtMembersItem2Title": "Üye Yönetimi",
  "@helpPtMembersItem2Title": { "description": "Help PT members item 2 title" },

  "helpPtMembersItem2Body": "Üye kartına tıklayarak profil detayını görüntüleyebilir, kişisel hedef ve notlar ekleyebilir, kalan seans haklarını takip edebilirsiniz.",
  "@helpPtMembersItem2Body": { "description": "Help PT members item 2 body" },

  "helpPtMembersItem3Title": "Aktif / Pasif Durumu",
  "@helpPtMembersItem3Title": { "description": "Help PT members item 3 title" },

  "helpPtMembersItem3Body": "Üyeyi pasife aldığınızda o üye yeni randevu talebi oluşturamaz. Aktivasyon isteği gönderirse siz onaylarsınız.",
  "@helpPtMembersItem3Body": { "description": "Help PT members item 3 body" },

  "helpPtPackagesTitle": "Paket Yönetimi",
  "@helpPtPackagesTitle": { "description": "Help PT packages section title" },

  "helpPtPackagesItem1Title": "Paket Oluşturma",
  "@helpPtPackagesItem1Title": { "description": "Help PT packages item 1 title" },

  "helpPtPackagesItem1Body": "Seans sayısı, süresi ve fiyatını belirleyerek paket oluşturabilirsiniz. Paketler tüm aktif üyelerinize görünür.",
  "@helpPtPackagesItem1Body": { "description": "Help PT packages item 1 body" },

  "helpPtPackagesItem2Title": "Üyeye Özel Paket",
  "@helpPtPackagesItem2Title": { "description": "Help PT packages item 2 title" },

  "helpPtPackagesItem2Body": "\"Üyeye özel\" seçeneğiyle belirli bir üye için özel fiyatlı paket tanımlayabilirsiniz. Bu paket yalnızca o üyenin Paketlerim ekranında görünür.",
  "@helpPtPackagesItem2Body": { "description": "Help PT packages item 2 body" },

  "helpPtPackagesItem3Title": "Seans Süresi",
  "@helpPtPackagesItem3Title": { "description": "Help PT packages item 3 title" },

  "helpPtPackagesItem3Body": "Pakette seans süresi belirtirseniz, o üye randevu alırken süre otomatik olarak belirlenir ve üye manuel seçim yapamaz.",
  "@helpPtPackagesItem3Body": { "description": "Help PT packages item 3 body" },

  "helpPtEarningsTitle": "Kazançlar & Ödemeler",
  "@helpPtEarningsTitle": { "description": "Help PT earnings section title" },

  "helpPtEarningsItem1Title": "Ödeme Onaylama",
  "@helpPtEarningsItem1Title": { "description": "Help PT earnings item 1 title" },

  "helpPtEarningsItem1Body": "Üye paket satın aldığında ödeme talebi oluşur. Siz onayladığınızda üyenin seans hakkı otomatik olarak güncellenir ve üyeye bildirim gider.",
  "@helpPtEarningsItem1Body": { "description": "Help PT earnings item 1 body" },

  "helpPtEarningsItem2Title": "Ödeme Reddetme",
  "@helpPtEarningsItem2Title": { "description": "Help PT earnings item 2 title" },

  "helpPtEarningsItem2Body": "Ödemenin gerçekleşmediği durumlarda talebi reddedebilirsiniz. Seans hakkı eklenmez.",
  "@helpPtEarningsItem2Body": { "description": "Help PT earnings item 2 body" },

  "helpPtEarningsItem3Title": "Kazanç Özeti",
  "@helpPtEarningsItem3Title": { "description": "Help PT earnings item 3 title" },

  "helpPtEarningsItem3Body": "Aylık ve toplam kazanç özeti ekranın üst kısmında görünür.",
  "@helpPtEarningsItem3Body": { "description": "Help PT earnings item 3 body" },

  "helpPtMessagesItem1Title": "Üye İletişimi",
  "@helpPtMessagesItem1Title": { "description": "Help PT messages item 1 title" },

  "helpPtMessagesItem1Body": "Tüm üyelerinizle ayrı ayrı mesajlaşabilirsiniz. Antrenman notları, diyet önerileri veya seans değişiklikleri için kullanın.",
  "@helpPtMessagesItem1Body": { "description": "Help PT messages item 1 body" },

  "helpTipBody": "Sorun yaşarsanız uygulamayı kapatıp yeniden açmayı deneyin. Bildirim almak için Profil → Bildirimler bölümünden bildirim izinlerini kontrol edin.",
  "@helpTipBody": { "description": "Help tip box body text" },

